{
  "name": "shannote",
  "version": "0.0.0",
  "description": "Shannote: a markdown second brain and daily planner operated through Claude via MCP",
  "type": "module",
  "license": "MIT",
  "bin": {
    "shannote": "dist/cli.js",
    "brain": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean --external @huggingface/transformers && npm run build:editor && cp src/web/ui.html dist/ui.html && cp -r src/web/fonts dist/fonts",
    "dev": "tsx src/cli.ts",
    "web": "tsx src/cli.ts web --open",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/editor",
    "build:editor": "esbuild src/web/editor/editor.ts --bundle --minify --format=iife --target=es2022 --outfile=dist/editor.js"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "marked": "^18.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.1"
  }
}
