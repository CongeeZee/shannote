{
  "name": "shannote",
  "version": "0.0.0",
  "description": "Shannote: a markdown second brain and daily planner operated through Claude via MCP",
  "type": "module",
  "license": "MIT",
  "bin": {
    "shannote": "dist/cli.js",
    "brain": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean --external @huggingface/transformers && cp src/web/ui.html dist/ui.html && cp -r src/web/fonts dist/fonts",
    "dev": "tsx src/cli.ts",
    "web": "tsx src/cli.ts web --open",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "marked": "^18.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.1"
  }
}
